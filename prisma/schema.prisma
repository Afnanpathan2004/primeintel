datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Service {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  basePrice   Float
  minPrice    Float
  maxPrice    Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PricingMultiplier {
  id          String   @id @default(cuid())
  category    String   // "environment", "scale", "complexity", "timeline"
  code        String   @unique
  label       String
  multiplier  Float
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AddOn {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  pricingType String   // "FIXED" | "PERCENTAGE"
  value       Float    // rupee amount or percentage e.g. 10 for 10%
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketBenchmark {
  id               String   @id @default(cuid())
  serviceKey       String
  region           String   @default("India")
  currency         String   @default("INR")
  lowPrice         Float
  highPrice        Float
  sourceName       String
  sourceUrl        String?
  retrievedDate    DateTime @default(now())
  scopeDescription String
  confidence       String   @default("Medium") // "High", "Medium", "Low"
  assumptions      String?
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PricingVersion {
  id             String     @id @default(cuid())
  version        String     @unique // e.g. "2026.10.01"
  description    String
  isActive       Boolean    @default(true)
  configSnapshot String     // Complete JSON snapshot of services, multipliers, add-ons
  createdAt      DateTime   @default(now())
  estimates      Estimate[]
}

model Estimate {
  id                    String          @id @default(cuid())
  estimateNumber        String          @unique // e.g. "PC-2026-0001"
  customerName          String
  companyName           String
  email                 String?
  phone                 String?
  website               String?
  rawRequirement        String
  structuredRequirement String          // JSON
  pricingVersionId      String
  pricingVersion        PricingVersion  @relation(fields: [pricingVersionId], references: [id])
  pricingSnapshot       String          // Immutable JSON snapshot of pricing rules used
  status                String          @default("DRAFT") // DRAFT, GENERATED, REVIEWED, SENT, ASSESSMENT_REQUESTED, PROPOSAL_CREATED, WON, LOST
  
  calculatedBasePrice   Float
  calculatedAddOnsTotal Float
  calculatedSubtotal    Float
  discountPercentage    Float           @default(0)
  discountAmount        Float           @default(0)
  adminOverridePrice    Float?
  overrideReason        String?
  finalPrice            Float
  indicativeLow         Float
  indicativeHigh        Float
  
  timelineWeeksMin      Int
  timelineWeeksMax      Int
  
  assumptions           String          // JSON array
  unknowns              String          // JSON array
  calculationBreakdown  String          // JSON object
  benchmarkComparison   String?         // JSON object
  internalNotes         String?
  
  createdBy             String          @default("PrimeCore Estimator")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   // "ESTIMATE", "PRICING_RULE", "DISCOUNT", "OVERRIDE"
  entityId    String
  action      String   // "CREATE", "UPDATE", "OVERRIDE", "STATUS_CHANGE"
  performedBy String
  oldValue    String?  // JSON
  newValue    String?  // JSON
  reason      String?
  createdAt   DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String   @default("ADMIN") // "ADMIN", "ESTIMATOR", "CONSULTANT"
  passwordHash String
  createdAt    DateTime @default(now())
}
