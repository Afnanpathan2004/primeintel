# ==============================================================================
# PRIMECORE INTERNAL ESTIMATION ENGINE (PRIMEINTEL) — ENVIRONMENT TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Supabase Transaction-Mode Pooler (Port 6543)
# Used at runtime by Next.js serverless functions on Vercel
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Supabase Session-Mode / Direct Connection (Port 5432)
# Used by Prisma CLI for migrations (npx prisma migrate deploy)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AI & EXTRACTOR CREDENTIALS
# ------------------------------------------------------------------------------
# Google Gemini API key for RequirementAnalyzer (Optional: offline heuristic fallback active if empty)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# High-entropy cryptographic secret for internal session cookies
ADMIN_SECRET="primecore-internal-admin-mvp-secret-key-2026"

# ------------------------------------------------------------------------------
# 4. SYSTEM ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
