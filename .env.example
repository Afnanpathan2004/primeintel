# Database URL (Managed PostgreSQL connection string: Supabase, Neon, AWS RDS, etc.)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/primeintel?schema=public"

# Google Gemini API Key for RequirementAnalyzer (Optional: fallback heuristic parser operates if not provided)
GEMINI_API_KEY=""

# Admin Session Secret (for signing internal session cookies)
ADMIN_SECRET="primecore-internal-admin-mvp-secret-key-2026"

# Environment Mode
NODE_ENV="development"
