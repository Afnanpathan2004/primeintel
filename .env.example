# Database URL (SQLite default for local zero-dependency execution)
DATABASE_URL="file:./dev.db"

# Google Gemini API Key for RequirementAnalyzer (Optional: fallback heuristic parser operates if not provided)
GEMINI_API_KEY=""

# Admin Session Secret (for signing internal session cookies)
ADMIN_SECRET="primecore-internal-admin-mvp-secret-key-2026"

# Environment Mode
NODE_ENV="development"
